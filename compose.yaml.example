services:
  meshcore-mqtt-broker:
    image: bjorkan/meshcore-mqtt-broker:latest
    restart: unless-stopped
    stop_grace_period: 30s
    healthcheck:
      test: ["CMD", "meshcore-mqtt-broker", "healthcheck"]
      interval: 30s
      timeout: 10s
      start_period: 30s
      retries: 3
    ports:
      - "127.0.0.1:443:8883"
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "3"
    # Stateless: the config file is the ONLY mount, strictly read-only.
    # No volumes, no /data, nothing is persisted.
    volumes:
      - ./config.yaml:/run/configs/meshcore-mqtt-broker-config.yaml:ro
