/data/
/logs/
*.log

# Local caches and temporary files
/.cache/
/.direnv/
/tmp/
/temp/
*.bak
*.swp
*.swo
*.zip
*.tar
*.tar.gz
*.tgz

# Docker Compose local overrides
compose.override.yaml
compose.override.yml
docker-compose.override.yaml
docker-compose.override.yml

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/

# Cargo.lock is intentionally tracked: this repository builds an application.
