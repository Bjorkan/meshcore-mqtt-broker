{
  "name": "meshcore-mqtt-broker",
  "version": "1.0.0",
  "description": "MeshCore MQTT broker with public key authentication",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "mc-mqtt": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:dashboard": "vite",
    "build": "tsc && vite build",
    "build:server": "tsc",
    "build:dashboard": "vite build",
    "test": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:ci": "npm run build && node --expose-gc --experimental-vm-modules node_modules/jest/bin/jest.js --ci --runInBand --verbose --showSeed --logHeapUsage --detectOpenHandles",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run check:lockfile && npm run format:check && npm run lint && npm run build",
    "start": "node dist/server.js",
    "check:lockfile": "node scripts/check-lockfile-portability.mjs",
    "dashboard:seed-demo": "node scripts/seed-dashboard-demo.mjs",
    "dashboard:screenshots": "node scripts/capture-dashboard-screenshots.mjs"
  },
  "keywords": [
    "meshcore",
    "mqtt",
    "broker"
  ],
  "author": "Michael Hart <michaelhart@michaelhart.me> (https://github.com/michaelhart)",
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@liamcottle/meshcore.js": "^1.13.0",
    "@michaelhart/meshcore-decoder": "^0.3.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@noble/curves": "^2.2.0",
    "@tursodatabase/database": "^0.7.1",
    "aedes": "^1.1.1",
    "ini": "^7.0.0",
    "mqtt": "^5.15.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tslog": "^4.11.0",
    "tsx": "^4.23.1",
    "ws": "^8.21.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@jest/globals": "30.4.1",
    "@playwright/test": "1.61.1",
    "@types/ini": "4.1.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jest": "30.4.2",
    "maplibre-gl": "5.24.0",
    "prettier": "3.9.5",
    "typescript": "7.0.2",
    "typescript-eslint": "8.64.0",
    "vite": "6.4.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "unrs-resolver@1.12.2": true
  }
}
