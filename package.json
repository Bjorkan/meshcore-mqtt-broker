{
  "name": "meshcore-mqtt-broker",
  "version": "1.0.0",
  "description": "MeshCore MQTT broker with public key authentication",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "mc-mqtt": "dist/cli.js"
  },
  "scripts": {
    "dev": "node --loader ts-node/esm src/server.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && esbuild src/dashboard-client.tsx --bundle --format=esm --platform=browser --target=es2020 --define:process.env.NODE_ENV=\\\"production\\\" --minify --outdir=dist/public --entry-names=dashboard-client --log-level=warning",
    "test": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:ci": "npm run build && node --expose-gc --experimental-vm-modules node_modules/jest/bin/jest.js --ci --runInBand --verbose --showSeed --logHeapUsage --detectOpenHandles",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run check:lockfile && npm run format:check && npm run lint && npm run build",
    "dashboard:screenshots": "npm run build && node scripts/capture-dashboard-screenshots.mjs",
    "start": "tsx src/server.ts",
    "check:lockfile": "node scripts/check-lockfile-portability.mjs"
  },
  "keywords": [
    "meshcore",
    "mqtt",
    "broker"
  ],
  "author": "Michael Hart <michaelhart@michaelhart.me> (https://github.com/michaelhart)",
  "contributors": [
    "Bjorkan"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjorkan/meshcore-mqtt-broker.git"
  },
  "homepage": "https://github.com/bjorkan/meshcore-mqtt-broker#readme",
  "bugs": {
    "url": "https://github.com/bjorkan/meshcore-mqtt-broker/issues"
  },
  "dependencies": {
    "@liamcottle/meshcore.js": "^1.13.0",
    "@michaelhart/meshcore-decoder": "^0.3.0",
    "@noble/curves": "^2.2.0",
    "@tursodatabase/database": "^0.7.1",
    "aedes": "^1.1.1",
    "ini": "^7.0.0",
    "mqtt": "^5.15.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tslog": "^5.1.0",
    "tsx": "^4.23.1",
    "ws": "^8.21.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@jest/globals": "30.4.1",
    "@playwright/test": "1.62.1",
    "@types/ini": "4.1.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "jest": "30.4.2",
    "maplibre-gl": "5.24.0",
    "prettier": "3.9.6",
    "ts-node": "10.9.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.64.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true
  }
}
