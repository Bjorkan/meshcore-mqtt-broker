{
  "name": "meshcore-mqtt-broker",
  "version": "1.0.0",
  "description": "MeshCore MQTT broker with public key authentication",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "main": "src/server.ts",
  "bin": {
    "mc-mqtt": "src/cli.ts"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/test-with-postgres.mjs",
    "test:postgres": "bun test",
    "test:ci": "bun test",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "db:migrate": "bun scripts/migrate-schema.ts",
    "start": "bun src/server.ts"
  },
  "keywords": [
    "meshcore",
    "mqtt",
    "broker"
  ],
  "author": "Michael Hart <michaelhart@michaelhart.me> (https://github.com/michaelhart)",
  "contributors": [
    "Bjorkan"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjorkan/meshcore-mqtt-broker.git"
  },
  "homepage": "https://github.com/bjorkan/meshcore-mqtt-broker#readme",
  "bugs": {
    "url": "https://github.com/bjorkan/meshcore-mqtt-broker/issues"
  },
  "dependencies": {
    "@liamcottle/meshcore.js": "^1.14.0",
    "@michaelhart/meshcore-decoder": "^0.3.0",
    "@msgpack/msgpack": "^3.1.3",
    "@noble/curves": "^2.3.0",
    "aedes": "^1.1.1",
    "ini": "^7.0.0",
    "mqtt": "^5.15.2",
    "tslog": "^5.1.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/bun": "1.4.0",
    "@types/ini": "4.1.1",
    "@types/ws": "8.18.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.10.0",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.67.0"
  },
  "scarfSettings": {
    "enabled": false
  }
}
